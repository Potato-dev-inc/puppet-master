packages/app/src-tauri/resources/mcp-stdio.bundle.cjs linguist-generated=true
packages/app/src-tauri/resources/pwa-dist/** linguist-generated=true
packages/app/dist/** linguist-generated=true
packages/app/dev-dist/** linguist-generated=true
packages/**/dist/** linguist-generated=true

# Definition fixtures are include_str!-ed and patched with multi-line string replaces in tests;
# keep them LF on every checkout (core.autocrlf=true would make them CRLF). Scoped to these dirs only.
packages/app/src-tauri/src/tui/declarative/fixtures/definitions/*.toml text eol=lf
packages/app/src-tauri/tests/agent-definitions/*.toml text eol=lf
# The wizard tests patch these drafts with multi-line string replaces too.
packages/app/src-tauri/src/tui/declarative/wizard/tests/drafts/*.toml text eol=lf

# The agent skill pack is include_str!-ed by the installer and compared byte for byte with the plugin copies;
# keep it LF on every checkout.
integrations/** text eol=lf
.claude-plugin/*.json text eol=lf
.agents/plugins/*.json text eol=lf

# Golden files compared byte for byte by the agent pack tests.
packages/app/src-tauri/src/agent_pack/golden/* text eol=lf

# Raw terminal bytes (cursor moves, CR/LF as the pane sent them), read by tests through the terminal emulator: never convert.
packages/app/src-tauri/src/tui/**/fixtures/*.ansi -text
