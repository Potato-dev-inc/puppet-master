{
  "$schema": "https://opencode.ai/config.json",
  "theme": "tokyonight",
  "mcp": {
    "puppet-master": {
      "command": [
        "npx",
        "-y",
        "@puppet-master/mcp"
      ],
      "enabled": true,
      "environment": {
        "PUPPET_MASTER_BRIDGE_PORT_FILE": "C:/pm/puppet-master.bridge.port"
      },
      "type": "local"
    }
  }
}
